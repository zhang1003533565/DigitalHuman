# Copy this file to .env on the server and fill real values there.
# Do not commit the real .env file.

ALIYUN_REGISTRY=crpi-awzm63dqn5ugddo8.cn-hangzhou.personal.cr.aliyuncs.com
ALIYUN_NAMESPACE=lukezhang
# Public repositories can leave these two empty on the server.
# GitHub Actions still needs ALIYUN_USERNAME and ALIYUN_PASSWORD secrets to push images.
ALIYUN_USERNAME=
ALIYUN_PASSWORD=

DIGITALHUMAN_IMAGE_TAG=latest
DIGITALHUMAN_BACKEND_REPOSITORY=digitalhuman-backend
DIGITALHUMAN_AI_SERVICE_REPOSITORY=digitalhuman-ai-service
DIGITALHUMAN_FRONTEND_ADMIN_REPOSITORY=digitalhuman-frontend-admin
DIGITALHUMAN_FRONTEND_VISITOR_REPOSITORY=digitalhuman-frontend-visitor
DIGITALHUMAN_BACKEND_IMAGE=crpi-awzm63dqn5ugddo8.cn-hangzhou.personal.cr.aliyuncs.com/lukezhang/digitalhuman-backend:latest
DIGITALHUMAN_AI_SERVICE_IMAGE=crpi-awzm63dqn5ugddo8.cn-hangzhou.personal.cr.aliyuncs.com/lukezhang/digitalhuman-ai-service:latest
DIGITALHUMAN_FRONTEND_ADMIN_IMAGE=crpi-awzm63dqn5ugddo8.cn-hangzhou.personal.cr.aliyuncs.com/lukezhang/digitalhuman-frontend-admin:latest
DIGITALHUMAN_FRONTEND_VISITOR_IMAGE=crpi-awzm63dqn5ugddo8.cn-hangzhou.personal.cr.aliyuncs.com/lukezhang/digitalhuman-frontend-visitor:latest

MYSQL_ROOT_PASSWORD=change-this-root-password
DB_NAME=digitalhuman
DB_USERNAME=root
